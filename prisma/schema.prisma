// DashDrop data model.
//
// The heart of the product is a *metadata-driven database*: a Workspace owns
// Collections (think "sheets"/"tables"), each Collection owns typed Fields
// (the metadata), and Records hold the actual rows as flexible JSON keyed by
// field key. Built-in templates (Inquiries, Tasks) are just Collections seeded
// with a predefined set of Fields.
//
// 手元は SQLite（インストール不要ですぐ動く）、本番は PostgreSQL。
//
// Prisma の `provider` は文字列リテラルしか受け付けないので、切り替えは
// scripts/db-provider.mjs が生成する写し（prisma/schema.generated.prisma）で行う。
// このファイルは常に sqlite のままで良い——本番向けのコマンドは生成側を見る。
//
//   DATABASE_PROVIDER=postgresql DATABASE_URL=postgresql://… npm run db:deploy
//
// スキーマ自体は最初から両対応で書いてある（列挙型は String + Zod、
// 行データは Json）。移行手順は docs/OPERATIONS.md。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  passwordHash    String
  name            String
  // メール確認が済んだ日時。null は未確認。
  // 未確認でもアプリは使えるが、外に出る操作（公開リンク）だけは止める。
  emailVerifiedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memberships     Membership[]
  records         Record[]     @relation("RecordAuthor")
  tokens          AuthToken[]

  @@index([email])
}

/**
 * パスワード再設定とメール確認の使い捨てトークン。
 * 生の値は保存しない。DBが漏れたときに、そのままアカウントを乗っ取れる鍵が
 * 並んでいることになるため、ハッシュだけを持つ（パスワードと同じ考え方）。
 */
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  // Purpose: "password_reset" | "email_verify"
  purpose   String
  // SHA-256 のハッシュ。照合は送られてきた値をハッシュして引く。
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

/**
 * 総当たり対策の試行回数。
 * メモリに持つとインスタンスを増やした時点で意味を失い、再起動でも消える
 * （攻撃者にとっては都合が良い）。DBに置けば台数が増えても効く。
 * 書き込みはログイン試行のときだけなので、量は問題にならない。
 */
model RateLimit {
  // 例: "login:user@example.com" / "login:203.0.113.9"
  key          String    @id
  count        Int       @default(0)
  windowStart  DateTime  @default(now())
  // ここまでは試行を受け付けない（ロック解除の時刻）。
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([windowStart])
}

model Workspace {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  // Plan: "free" | "pro" | "business"
  plan            String           @default("free")
  /**
   * 取り込み時に AI へ内容を渡してよいか。
   * 列名とサンプル値が外部（Anthropic）に出るので、社内規程で外に出せない
   * 会社が必ずある。既定は有効だが、切れば決定的なルールだけで動く。
   */
  aiEnabled       Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  memberships     Membership[]
  collections     Collection[]
  workbooks       Workbook[]
  activities      Activity[]
  dashboards      Dashboard[]
  notifications   Notification[]
  alertRules      AlertRule[]
  reportSchedules ReportSchedule[]
  integrations    Integration[]
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  // Role: "owner" | "admin" | "member"
  role        String    @default("member")
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// A Workbook groups the spreadsheets (Collections) that came from one imported
// file — e.g. "売上.xlsx" whose tabs become sheets nested under it. Shown as a
// collapsible file → sheets tree in the navigator.
model Workbook {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  // Origin: "excel" | "csv" | "gsheets"
  source      String       @default("excel")
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  collections Collection[]

  @@index([workspaceId])
}

model Collection {
  id          String    @id @default(cuid())
  workspaceId String
  // Parent file (workbook). Null for standalone/template spreadsheets.
  workbookId  String?
  name        String
  slug        String
  description String    @default("")
  icon        String    @default("table")
  color       String    @default("khaki")
  // Template origin: "inquiry" | "task" | "custom"
  template    String    @default("custom")
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workbook    Workbook? @relation(fields: [workbookId], references: [id], onDelete: SetNull)
  fields      Field[]
  records     Record[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([workbookId])
}

model Field {
  id           String     @id @default(cuid())
  collectionId String
  // Stable machine key used inside Record.data JSON
  key          String
  name         String
  // Type: text | longtext | number | currency | select | multiselect
  //       | date | checkbox | email | phone | url
  type         String     @default("text")
  required     Boolean    @default(false)
  // For select/multiselect: JSON array of { label, value, color }
  options      Json?
  // Extra per-type config (e.g. number precision, date format)
  config       Json?
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, key])
  @@index([collectionId])
}

model Record {
  id           String     @id @default(cuid())
  collectionId String
  // Row payload keyed by Field.key
  data         Json
  // True for rows seeded by a dashboard template so the user can bulk-clear
  // sample data once they start entering real records.
  isSampleData Boolean    @default(false)
  createdById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdBy    User?      @relation("RecordAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@index([collectionId, createdAt])
}

// A saved dashboard bound to a workspace: a titled arrangement of widgets
// (KPI tiles + charts) computed from the workspace's collections. Created by
// applying a gallery template or by the AI "from attachment" flow. The concrete
// widget layout lives in `layout` (validated by src/lib/widgets.ts).
model Dashboard {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String
  category        String    @default("custom")
  description     String    @default("")
  icon            String    @default("dashboard")
  color           String    @default("khaki")
  /// グラフの配色テーマ（src/lib/palette.ts の Palette.key）。
  /// 取り込みのときに選ばれ、以後この画面のグラフ全部に効く。
  /// 未知の値は標準に落ちるので、消したテーマがあってもダッシュボードは壊れない。
  theme           String    @default("standard")
  // Slugs of the collections this dashboard reads (resolved within workspace).
  collectionSlugs Json
  // Array of widget specs (see WidgetSpec in src/lib/widgets.ts).
  layout          Json
  // Origin: "template:<key>" | "ai" | "custom"
  source          String    @default("custom")
  position        Int       @default(0)
  // When set, the dashboard is viewable read-only at /share/d/<shareToken>
  // without authentication. Null = private. Revoking clears it.
  shareToken      String?   @unique
  sharedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// In-app notification inbox (also the fallback channel for alerts/reports when
// email/Slack aren't configured).
model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  // Type: "alert" | "report" | "system"
  type        String    @default("alert")
  title       String
  body        String    @default("")
  url         String?
  read        Boolean   @default(false)
  meta        Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, read])
}

// A threshold alert: evaluate a metric over a spreadsheet and notify when it
// crosses a bound (e.g. 未対応 > 10).
model AlertRule {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String
  collectionId    String
  // Metric: JSON { measure: Measure, filters?: Filter[] } (see src/lib/widgets.ts)
  metric          Json
  // Operator: "gt" | "gte" | "lt" | "lte"
  operator        String    @default("gt")
  threshold       Float
  // Channel: "inapp" | "email" | "slack"
  channel         String    @default("inapp")
  enabled         Boolean   @default(true)
  lastValue       Float?
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// A scheduled report: periodically deliver a dashboard snapshot (email when
// configured, otherwise an in-app notification with the report link).
model ReportSchedule {
  id          String    @id @default(cuid())
  workspaceId String
  dashboardId String
  // Frequency: "daily" | "weekly" | "monthly"
  frequency   String    @default("weekly")
  recipients  Json? // string[] of email addresses
  enabled     Boolean   @default(true)
  lastSentAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// A third-party connection owned by ONE workspace (Slack, Notion, …).
//
// Credentials are per-workspace, never global: a single deployment-wide webhook
// would post every tenant's notifications into the same channel. `secret` holds
// the token/URL encrypted at rest (see src/lib/crypto.ts) so a database dump
// does not hand over live credentials.
model Integration {
  id          String    @id @default(cuid())
  workspaceId String
  // Provider: "slack" | "notion"
  provider    String
  // Encrypted credential (Slack incoming-webhook URL, Notion integration token)
  secret      String
  // Non-secret settings, e.g. { channelHint } / { defaultDatabaseId }
  config      Json?
  enabled     Boolean   @default(true)
  lastOkAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([workspaceId])
}

// Lightweight event stream powering the weekly performance charts.
model Activity {
  id          String    @id @default(cuid())
  workspaceId String
  // Type: "record.created" | "record.updated" | "record.deleted"
  //       | "inquiry.resolved" | "task.completed" | "import.completed"
  type        String
  meta        Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}
