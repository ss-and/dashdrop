# ─────────────────────────────────────────────────────────────
# DashDrop — Environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` (it is gitignored).
# ─────────────────────────────────────────────────────────────

# --- Core ---
# App base URL (used for absolute links, cookies, emails)
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database ---
# Development uses SQLite (file-based). For production switch to Postgres:
#   DATABASE_URL="postgresql://user:password@host:5432/dashdrop?schema=public"
# 本番で file: のまま起動すると例外で止まります（意図的な安全装置です）。
# サーバーレス（Vercel など）では SQLite は一時ファイルシステムに作られ、書き込みは
# 成功したように見えて、インスタンスが破棄された時点で黙って消えるためです。
DATABASE_URL="file:./dev.db"
# Prisma の datasource provider。`sqlite`（既定・手元）か `postgresql`（本番）。
# provider は Prisma のスキーマに env() で書けないので、scripts/db-provider.mjs が
# この値を見て prisma/schema.generated.prisma を作り、npm run db:deploy / db:migrate は
# そちらを使います。**DATABASE_URL を Postgres にしたら、必ずこちらも postgresql に
# すること**（片方だけ変えると provider と接続先が食い違って起動時に落ちます）。
DATABASE_PROVIDER="sqlite"

# --- Authentication ---
# 32+ char random secret. Signs session JWTs AND derives the encryption key for
# stored integration tokens (Slack / Notion), so a leaked value breaks both.
# `npm run setup` generates a unique value automatically; set it yourself in
# production with:  openssl rand -base64 48
# 下のプレースホルダのままでは本番起動できません（意図的な安全装置です）。
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"
# Session lifetime in seconds (default 7 days)
SESSION_MAX_AGE="604800"

# --- Billing (Stripe) — optional, for commercial use ---
# Leave blank to run in "billing disabled" mode.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# --- AI (dashboard generation from PPTX/PDF/screenshot) ---
# The "attach an image and generate a dashboard" flow uses whichever key is set,
# preferring Anthropic. With neither key, it falls back to a heuristic generator.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- External API integrations (future) ---
GOOGLE_SHEETS_CLIENT_ID=""
GOOGLE_SHEETS_CLIENT_SECRET=""

# --- Alerts (optional) ---
# Incoming webhook for Slack alert delivery. Blank = in-app notifications only.
# 自分だけで使う（ワークスペースが1つだけの）自己ホスト向けの簡易設定です。
# ワークスペースが2つ以上あるデプロイでは、この値は自動的に無視されます —
# 全ワークスペースの通知が1つのチャンネルに流れ込むのを防ぐためです。
# 複数人・複数社で使う場合は、設定画面から各ワークスペースで Slack を接続してください。
# https://hooks.slack.com/ 以外のURLは受け付けません。
SLACK_WEBHOOK_URL=""
# 上を有効にするには、単一テナントであることを明示的に宣言してください。
# 宣言が無い場合、SLACK_WEBHOOK_URL は無視されます（安全側の既定）。
SLACK_WEBHOOK_SINGLE_TENANT=""

# --- 監視（任意）---
# 拾えなかった例外の通知先。設定すると1件ずつ POST します（Slack の Incoming
# Webhook でも、監視SaaS の受け口でも可）。未設定なら1行JSONのログに出るだけです。
ERROR_WEBHOOK_URL=""

# --- 定期実行（cron）---
# アラートの定期評価エンドポイント `/api/cron/alerts` を守る共有シークレット。
# これが未設定の間、エンドポイントは全てのリクエストを拒否します（無認証で
# 動かすくらいなら動かさない、という安全側の既定です）。つまり **未設定なら
# アラートは自動では飛びません**（画面の「今すぐ評価する」だけになります）。
# 生成方法:  openssl rand -base64 32
CRON_SECRET=""
# 未設定の場合、/api/cron/alerts と /api/reports/dispatch は全ての呼び出しを
# 拒否します（認証なしで動かさないための安全側の既定）。つまりアラートも
# レポートも自動では届かず、画面のボタンを押したときだけ届きます。
#
# 呼び出し方（外部スケジューラ・cron・GitHub Actions などから）:
#   curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" \
#     https://<your-app>/api/cron/alerts
# Vercel にデプロイする場合は vercel.json の crons が 15分ごとに同じURLを
# GET で呼び、Authorization ヘッダは Vercel が CRON_SECRET から自動で付けます
# （プロジェクトの環境変数に同名で登録しておくこと）。
# Vercel 以外（自前サーバ、Fly.io、Render など）では上の curl を crontab や
# systemd timer に登録してください。例（15分ごと）:
#   */15 * * * * curl -fsS -X POST -H "Authorization: Bearer ..." https://.../api/cron/alerts
# 1回の実行は約50秒で打ち切り、間に合わなかったワークスペースは次回に回ります
# （応答の skipped / skippedWorkspaceIds に何が残ったかが出ます）。

# --- Email (transactional) — optional ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="DashDrop <no-reply@dashdrop.app>"

# --- デモデータの投入（環境変数としては設定しません）---
# `npm run db:seed` は NODE_ENV=production では実行を拒否します。デモアカウント
# （owner@demo.dashdrop / パスワードは prisma/seed.ts に平文で記載）が本番に
# 入ると、リポジトリを読める全員がオーナー権限でログインできてしまうためです。
# デモ用インスタンスなど、承知のうえで投入するときだけ、その場で明示してください:
#   ALLOW_PRODUCTION_SEED=1 npm run db:seed
