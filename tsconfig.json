{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // .next は開発サーバー、.next-build は本番ビルドの出力（next.config.mjs の
  // distDir を参照）。どちらが生成した型定義でも拾えるように両方入れておく。
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-build/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    // 使い捨ての検証用テスト（tests/_… ）。手元で動かすためのもので、
    // 型が通らないままでも CI を落とさないよう対象外にする。
    "tests/_*.test.ts",
    "tests/_*.test.tsx"
  ]
}
