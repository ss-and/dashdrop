# dependencies
/node_modules
/.pnp
.pnp.*

# prisma — provider を差し替えた生成物（scripts/db-provider.mjs）
/prisma/schema.generated.prisma

# next.js
/.next/
# 本番ビルドの出力（開発サーバーの .next と混ざらないように分けてある）
/.next-build/
/out/
next-env.d.ts

# production
/build

# env — never commit real secrets
.env
.env.*
.env*.local
.env.production

# database (SQLite dev)
/prisma/*.db
/prisma/*.db-journal
/prisma/dev.db*

# testing
/coverage

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vscode/*
!.vscode/extensions.json
.idea

# typescript
*.tsbuildinfo

# scratch test probes
tests/_*.test.ts
tests/_*.test.tsx

# 使い捨ての再現スクリプト（実DB相手に挙動を確かめるためのもの）
.probe*.ts
.probe*.mts

# throwaway E2E scripts
_*.mjs

# 使い捨ての検証用テスト。実装を実際に動かして仮説を確かめるために置くもので、
# 成果物ではないのでコミットしない。残す価値のある検証は、ちゃんとした名前の
# テストとして書き直すこと。
tests/zzprobe*
tests/*.scratch.test.ts

# 負荷計測の使い捨てDB
/prisma/bench.db

# Vercel
.vercel
